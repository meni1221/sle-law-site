# Canonical site URL used for SEO canonical tags and sitemap links.
VITE_SITE_URL=https://www.sle-law.co.il

# Contact form delivery endpoint (POST JSON: name, email, phone, subject, message).
# Free default: FormSubmit AJAX to the office inbox (no signup; first test
# submission sends an activation email to the office — click "Activate" once).
VITE_CONTACT_ENDPOINT=https://formsubmit.co/ajax/Shiraneldar@gmail.com

# API key sent as `Authorization: Bearer <key>` with form submissions.
# Never commit real keys to version control.
VITE_CONTACT_API_KEY=

# Google Analytics 4 measurement ID (loaded only after cookie consent).
VITE_GA4_ID=

# Microsoft Clarity project ID (loaded only after cookie consent).
VITE_CLARITY_ID=
